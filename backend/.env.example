APP_NAME="Toko Online Terpadu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=naura
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Sanctum: domain frontend yang diizinkan (dashboard React)
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173
FRONTEND_URL=http://127.0.0.1:5173

# CORS origin yang diizinkan (dashboard + mobile dev)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@naura.test"
MAIL_FROM_NAME="${APP_NAME}"

# Ongkir RajaOngkir (Komerce) — https://rajaongkir.com/docs
# API key "Shipping Cost" dari Collaborator Dashboard. Kosongkan → ongkir flat.
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1/
RAJAONGKIR_API_KEY=
RAJAONGKIR_COURIERS=jne:jnt:sicepat:pos
# Lokasi asal toko disimpan di store_settings:
#   php artisan store:shipping-origin "nama kecamatan/kelurahan toko"
